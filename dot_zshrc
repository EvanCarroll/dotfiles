# alias cp="kitty +kitten ssh -A ubuntu@cp-terraform"

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
# Prompt is starship (below), not an oh-my-zsh theme.
ZSH_THEME=""

# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/ssh-agent#agent-forwarding
zstyle :omz:plugins:ssh-agent agent-forwarding yes
zstyle :omz:plugins:ssh-agent quiet yes
zstyle :omz:plugins:ssh-agent lazy yes

plugins=(git ssh-agent)

source $ZSH/oh-my-zsh.sh

# After oh-my-zsh so these win (ls -> lsd).
source "$HOME/.config/zsh/aliases.zsh"

# Prompt: ~/.config/starship.toml. Installed by run_onchange_after_20-rust.sh.
if (( $+commands[starship] )); then
	eval "$(starship init zsh)"
fi
