# ~/.profile: login shells (zsh via ~/.zprofile, and sh -l). POSIX sh only.
# Plain environment variables belong in ~/.config/environment.d and aliases
# in ~/.config/zsh/aliases.zsh; this file is for what can't go there.

. "$HOME/.config/shell/environment.sh"

# Apple is GARBAGE (conditional, so it can't live in environment.d)
# https://apple.stackexchange.com/q/455562/76955
if [ "$(uname -m)" = "aarch64" ]; then
	export LIBGL_ALWAYS_SOFTWARE=true
fi
