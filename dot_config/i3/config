mode "kill" {
	bindsym v exec killall -s 9 vlc, $mode_clear $mode_notification_id, mode "default"
	bindsym d exec killall -s 9 Discord, $mode_clear $mode_notification_id, mode "default"
	bindsym r exec killall -s 9 ranger, $mode_clear $mode_notification_id, mode "default"
	bindsym z exec killall -s 9 zoom, $mode_clear $mode_notification_id, mode "default"
	bindsym o exec killall -s 9 obs, $mode_clear $mode_notification_id, mode "default"
	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}

mode "focus" {
	bindsym y [title="YouTube"] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym v [title="Voice - "] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym d [title="Discord"] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym t [title="Microsoft Teams"] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym z [title="^Zoom (?:Meeting|Webinar)"] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym m [title="Mail - Evan Carroll"] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+Z [title="Zim"] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+S [title="Signal"] focus, $mode_clear $mode_notification_id, mode "default"
	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}

mode "apps" {
	bindsym d exec discord, $mode_clear $mode_notification_id, mode "default"
	bindsym p exec --no-startup-id projectM-pulseaudio, $mode_clear $mode_notification_id, mode "default"
	bindsym v exec --no-startup-id vlc, $mode_clear $mode_notification_id, mode "default"
	bindsym m exec --no-startup-id vlc, exec --no-startup-id projectM-pulseaudio; $mode_clear $mode_notification_id, mode "default"
	bindsym x $mode_notify $mode_notification_id "KILL", mode "kill"
	bindsym f $mode_notify $mode_notification_id "FOCUS", mode "focus"
	bindsym k $mode_notify $mode_notification_id "KILL", mode "kill"
	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}
bindsym $mod+a $mode_notify $mode_notification_id "APPS", mode "apps"

mode "resize" {
	bindsym h resize shrink width 10 px or 10 ppt
	bindsym j resize grow height 10 px or 10 ppt
	bindsym k resize shrink height 10 px or 10 ppt
	bindsym l resize grow width 10 px or 10 ppt
  bindsym Return $mode_clear $mode_notification_id, mode "default"
  bindsym Escape $mode_clear $mode_notification_id, mode "default"
  bindsym $mod+r $mode_clear $mode_notification_id, mode "default"
}
bindsym $mod+r $mode_notify $mode_notification_id "RESIZE", mode "resize"
 
