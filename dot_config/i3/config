# i3 config file (v4)

exec_always --no-startup-id ~/.cargo/bin/i3-spatial-desktop --desktop-origin-hotkey=down daemon
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id dunst
set $mod Mod4
# Reuse one persistent Dunst notification for every i3 mode.
set $mode_notification_id 123
set $mode_notify exec --no-startup-id ~/.config/i3/mode-notify
set $mode_clear  exec --no-startup-id ~/.config/i3/mode-notify --clear
floating_modifier $mod

font pango:"Fira Code" 12
focus_follows_mouse no
default_border pixel 3
hide_edge_borders none

set $rel nop i3-spatial-desktop

set $term    kitty
set $browser chromium --new-window --password-store=basic
set $menu    i3-dmenu-desktop
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id $menu

for_window [class="kitty" title="^termfilechooser$"] floating enable, resize set 1200 800, move position center

set $ws1       "1:product"
set $ws2       "2:site"
set $ws3       "3"
set $ws4       "4"
set $ws5       "5"
set $ws6       "6"
set $ws7       "7:gmail"
set $ws8       "8:work"
set $ws_work   "8:work"
set $ws9       "9:media"
set $ws_media  "9:media"
set $ws10      "10:com"
set $ws_comm   "10:com"
# timeout 15 /usr/bin/bluetoothctl scan on; /usr/bin/bluetoothctl scan off; bluetoothctl devices | grep -F 'DCR010' | cut -f 2 -d ' ')"
set $bt_dewalt  "$(bluetoothctl devices | perl -anE 'print $F[1] if qq[@F[2...$#F]] eq q[DCR010]')"
set $bt_mouse   "$(bluetoothctl devices | perl -anE 'print $F[1] if qq[@F[2...$#F]] eq q[MX Ergo]')"
set $bt_lenovo  "$(bluetoothctl devices | perl -anE 'print $F[1] if qq[@F[2...$#F]] eq q[Lenovo 700 BT Speaker]')"
set $bt_q5k     "$(bluetoothctl devices | perl -anE 'print $F[1] if qq[@F[2...$#F]] eq q[Qudelix-5K]')"
set $bt_cowin   "$(bluetoothctl devices | perl -anE 'print $F[1] if qq[@F[2...$#F]] eq q[COWIN E9]')"

bindsym $mod+1             $rel goto $ws1
bindsym $mod+2             $rel goto $ws2
bindsym $mod+3             $rel goto $ws3
bindsym $mod+4             $rel goto $ws4
bindsym $mod+5             $rel goto $ws5
bindsym $mod+6             $rel goto $ws6
bindsym $mod+7             $rel goto $ws7
bindsym $mod+8             $rel goto $ws8
bindsym $mod+9             $rel goto $ws9
bindsym $mod+0             $rel goto $ws10
bindsym $mod+Shift+1       $rel send $ws1
bindsym $mod+Shift+2       $rel send $ws2
bindsym $mod+Shift+3       $rel send $ws3
bindsym $mod+Shift+4       $rel send $ws4
bindsym $mod+Shift+5       $rel send $ws5
bindsym $mod+Shift+6       $rel send $ws6
bindsym $mod+Shift+7       $rel send $ws7
bindsym $mod+Shift+8       $rel send $ws8
bindsym $mod+Shift+9       $rel send $ws9
bindsym $mod+Shift+0       $rel send $ws10
bindsym $mod+Up            $rel focus up
bindsym $mod+Down          $rel focus down
bindsym $mod+Left          $rel focus left
bindsym $mod+Right         $rel focus right
bindsym $mod+Shift+Up      $rel move up
bindsym $mod+Shift+Down    $rel move down
bindsym $mod+Shift+Left    $rel move left
bindsym $mod+Shift+Right   $rel move right
bindsym $mod+bracketright  $rel output right
bindsym $mod+bracketleft   $rel output left

bindsym $mod+Shift+R       exec i3-input -F 'rename workspace to "%s"' -P 'Rename desktop: '

bindsym $mod+h             focus left
bindsym $mod+j             focus down
bindsym $mod+k             focus up
bindsym $mod+l             focus right
bindsym $mod+Shift+h       move left
bindsym $mod+Shift+j       move down
bindsym $mod+Shift+k       move up
bindsym $mod+Shift+l       move right

bindsym XF86AudioRaiseVolume  exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@ off; exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume  exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute         exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute      exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
# XF86AudioPause bound to FN+p by bios on thinkpad
bindsym Pause                 exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous
# bindsym $mod+Up               exec --no-startup-id playerctl play-pause
# bindsym $mod+Right            exec --no-startup-id playerctl next
# bindsym $mod+Left             exec --no-startup-id playerctl previous
# bindsym $mod+Down             exec --no-startup-id playerctl stop
bindsym XF86MonBrightnessUp   exec --no-startup-id light -A "5%"
bindsym XF86MonBrightnessDown exec --no-startup-id light -U "5%"
bindsym $mod+Print   exec xfce4-screenshooter
bindsym $mod+f       fullscreen
bindsym $mod+Shift+v splith
bindsym $mod+v       splitv
bindsym $mod+Shift+s layout stacking
bindsym $mod+w       layout tabbed
bindsym $mod+e       layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show
bindsym $mod+space       focus mode_toggle
bindsym $mod+Tab         workspace back_and_forth
# focus the parent container
#bindsym $mod+a focus parent
#bindsym $mod+d focus child


for_window [class="xdg-desktop-portal-gtk"] floating enable, focus
for_window [window_role="GtkFileChooserDialog"] floating enable, focus

bindsym Control+mod1+Delete exec xdg-screensaver activate

assign [class="^kitty$" instance="^__code__"]                          → $ws1

assign [window_role="^browser$" title="me@evancarroll.com - Evancarroll.com Mail"] → $ws7
assign [window_role="^browser$" instance="^reddit.com"]            → $ws7
assign [window_role="^browser$" title="reddit"]                    → $ws7

#assign [class="^vlc$"]                                             → $ws_media
assign [class="^ProjectM"]                                         → $ws_media
assign [window_role="^browser$" title="YouTube"]                   → $ws_media
assign [window_role="^browser$" title="Google Play Music"]         → $ws_media
