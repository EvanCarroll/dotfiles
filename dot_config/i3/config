mode "console" {
	bindsym s exec $term --name"=__scratch__" rax2 -l, $mode_clear $mode_notification_id, mode "default"
	bindsym i exec $term --name="__irssi__"   tmux new-session -A -s com 'irssi', $mode_clear $mode_notification_id, mode "default"
