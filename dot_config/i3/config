	bindsym n exec $term --name="__news__"    tmux new-session -A -s news, $mode_clear $mode_notification_id, mode "default"
	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}
bindsym $mod+c $mode_notify $mode_notification_id "CONSOLE", mode "console"

# Maybe some day, I won't *have* to use i3
mode "window_manager" {
	## Disruptives use capitals
	bindsym Shift+r restart , $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+e $mode_clear $mode_notification_id, exit

	bindsym r reload, $mode_clear $mode_notification_id, mode "default"

	#bindsym l exec --no-startup-id i3lock -i /home/ecarroll/Pictures/ohm.png, $mode_clear $mode_notification_id, mode "default"
	bindsym l exec --no-startup-id xscreensaver-command -lock, $mode_clear $mode_notification_id, mode "default"
	#bindsym s exec --no-startup-id systemctl suspend -f -i, $mode_clear $mode_notification_id, mode "default"
	bindsym s exec --no-startup-id xscreensaver-command -lock, exec --no-startup-id systemctl suspend -i, $mode_clear $mode_notification_id, mode "default"
	bindsym e exec "gvim ~/.config/i3/config", $mode_clear $mode_notification_id, mode "default"

	# just point to the external monitor, will work only if one is installed
	# down turns off, up turns on
	bindsym Up    exec xrandr --auto
	bindsym Left  exec xrandr --output "$(xrandr | sed -ne'/eDP-1/d' -e's/ connected.*//p')" --left-of  eDP-1, $mode_clear $mode_notification_id, mode "default"
	bindsym Right exec xrandr --output "$(xrandr | sed -ne'/eDP-1/d' -e's/ connected.*//p')" --right-of eDP-1, $mode_clear $mode_notification_id, mode "default"
	bindsym Down  exec xrandr --output "$(xrandr | sed -ne'/eDP-1/d' -e's/ connected.*//p')" --off, $mode_clear $mode_notification_id, mode "default"

	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}
bindsym $mod+BackSpace $mode_notify $mode_notification_id "WINDOW MANAGER", mode "window_manager"

mode "power" {
	bindsym s exec --no-startup-id systemctl suspend, $mode_clear $mode_notification_id, mode "default"
	# bindsym p exec --no-startup-id sudo cpupower frequency-set -g performance && dunstify "POWER: Performance", $mode_clear $mode_notification_id, mode "default"
	# bindsym e exec --no-startup-id sudo cpupower frequency-set -g powersave && dunstify "POWER: Economy Mode", $mode_clear $mode_notification_id, mode "default"
	bindsym b exec       --no-startup-id bluetoothctl power on , $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+B exec --no-startup-id bluetoothctl power off, $mode_clear $mode_notification_id, mode "default"
	bindsym w exec       --no-startup-id /sbin/rfkill unblock wifi, $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+W exec --no-startup-id /sbin/rfkill block wifi  , $mode_clear $mode_notification_id, mode "default"

	bindsym Up   exec --no-startup-id light -A 2%
	bindsym Down exec --no-startup-id light -U 2%
	bindsym Shift+Up   exec --no-startup-id light -S 100
	bindsym Shift+Down exec --no-startup-id light -S 0.01
	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}

mode "bluetooth" {
	# cowin
	bindsym c       exec --no-startup-id bluetoothctl connect    $bt_cowin,  $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+C exec --no-startup-id bluetoothctl disconnect $bt_cowin,  $mode_clear $mode_notification_id, mode "default"
	bindsym q       exec --no-startup-id bluetoothctl connect    $bt_q5k,    $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+Q exec --no-startup-id bluetoothctl disconnect $bt_q5k,    $mode_clear $mode_notification_id, mode "default"
	bindsym l       exec --no-startup-id bluetoothctl connect    $bt_lenovo, $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+L exec --no-startup-id bluetoothctl disconnect $bt_lenovo, $mode_clear $mode_notification_id, mode "default"
	bindsym m       exec --no-startup-id bluetoothctl connect    $bt_mouse,  $mode_clear $mode_notification_id, mode "default"
	bindsym Shift+M exec --no-startup-id bluetoothctl disconnect $bt_mouse,  $mode_clear $mode_notification_id, mode "default"

	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}

mode "system" {
	bindsym b $mode_notify $mode_notification_id "BLUETOOTH", mode "bluetooth"
	bindsym p $mode_notify $mode_notification_id "POWER", mode "power"
	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
}
bindsym $mod+s $mode_notify $mode_notification_id "SYSTEM", mode "system"

