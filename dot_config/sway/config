# sway conf file
# Mirrors ~/.config/i3/config where it applies. Left out on purpose: polybar,
# i3-spatial-desktop, i3-input, xfce4-screenshooter, xscreensaver, xrandr.

# Same keymap as the X11 session (~/.xsessionrc): Caps Lock -> Super, Win keys
# stay Super. libxkbcommon finds ~/.config/xkb/symbols/local on its own.
input type:keyboard xkb_file ~/.config/xkb/keymap.xkb

exec --no-startup-id dunst
set $mod Mod4
# Reuse one persistent Dunst notification for every sway mode.
set $mode_notification_id 123
set $mode_notify exec --no-startup-id ~/.config/sway/mode-notify
set $mode_clear  exec --no-startup-id ~/.config/sway/mode-notify --clear
floating_modifier $mod normal

font Fira Code 12
focus_follows_mouse no
default_border pixel 3
hide_edge_borders none

set $term    kitty
set $browser chromium --disable-gpu-driver-bug-workarounds --new-window --password-store=basic
set $menu    dmenu_path | dmenu | xargs swaymsg exec --
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu

for_window [app_id="^kitty$" title="^termfilechooser$"] floating enable, resize set 1200 800, move position center

set $left    h
set $down    j
set $up      k
set $right   l

set $ws1       "1:product"
set $ws2       "2:site"
set $ws3       "3"
set $ws4       "4"
