	bindsym $left  resize shrink width 10 px or 10 ppt
	bindsym $down  resize grow height 10 px or 10 ppt
	bindsym $up    resize shrink height 10 px or 10 ppt
	bindsym $right resize grow width 10 px or 10 ppt
	bindsym Return $mode_clear $mode_notification_id, mode "default"
	bindsym Escape $mode_clear $mode_notification_id, mode "default"
	bindsym $mod+r $mode_clear $mode_notification_id, mode "default"
}
bindsym $mod+r $mode_notify $mode_notification_id "RESIZE", mode "resize"

