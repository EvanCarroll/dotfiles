{{- /*
  Status line for sway's bar (status_command i3status). Based on Debian's
  /etc/i3status.conf.

  i3status only looks for BAT<n> under /sys/class/power_supply, so it reports
  "No Battery" on machines that name theirs differently (e.g. Apple Silicon
  under Asahi: macsmc-battery). Find the system battery on the machine this is
  applied to; peripherals such as hidpp_battery_0 (a mouse) don't match.
  With no battery (desktops) the module is left out.
*/ -}}
{{- $battery := "" -}}
{{- range glob "/sys/class/power_supply/*" -}}
{{-   if and (eq $battery "") (regexMatch "(?i)^(bat[0-9]+|[a-z0-9]+-battery)$" (base .)) -}}
{{-     $battery = base . -}}
{{-   end -}}
{{- end -}}
# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
}

order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
{{ if $battery -}}
order += "battery 0"
{{ end -}}
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

{{ if $battery -}}
battery 0 {
        path = "/sys/class/power_supply/{{ $battery }}/uevent"
        format = "%status %percentage %remaining"
}

{{ end -}}
disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "%used | %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}
